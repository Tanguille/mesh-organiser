{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended"],
  // Matches the old Dependabot open-pull-requests-limit.
  prConcurrentLimit: 5,
  // A fork is only processed with a committed config; this keeps it that way if the file moves.
  forkProcessing: "enabled",
  // Dependabot's labels and `deps(<ecosystem>):` commit prefixes, kept so history and filters stay the same.
  labels: ["dependencies"],
  semanticCommits: "disabled",
  packageRules: [
    { matchManagers: ["npm"], addLabels: ["npm"], commitMessagePrefix: "deps(npm):" },
    { matchManagers: ["cargo"], addLabels: ["rust"], commitMessagePrefix: "deps(rust):" },
    { matchManagers: ["github-actions"], addLabels: ["github-actions"], commitMessagePrefix: "deps(ci):" },
    { matchManagers: ["dockerfile"], addLabels: ["docker"], commitMessagePrefix: "deps(docker):" }
  ]
}
