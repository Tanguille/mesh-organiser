{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "abandonments:recommended",
    // pnpm rejects npm releases younger than its minimumReleaseAge (1 day) in CI's
    // `pnpm install --frozen-lockfile`; this holds npm PRs 3 days (patches: 1, below).
    "security:minimumReleaseAgeNpm",
    // Pin every github> preset to the same tag; an unpinned one tracks main.
    "github>home-operations/renovate-presets#11.0.0",
  ],
  // This repo is a fork; only a committed config makes Renovate process it.
  forkProcessing: "enabled",
  // Dependabot labelled every update PR.
  labels: ["dependencies"],
  // Overrides :automergeBranch from the base preset.
  automergeType: "pr",
  // main has no required checks, so GitHub native auto-merge would merge before CI finishes;
  // with this off Renovate merges itself only once every check is green (needs Checks: read).
  platformAutomerge: false,
  // The operator webhook starts a run on any ticked dashboard checkbox; Renovate resets it on rewrite.
  dependencyDashboard: {
    footer: "- [ ] <!-- manual job -->Check this box to trigger a request for Renovate to run again on this repository",
  },
  packageRules: [
    // The base preset titles majors and 0.x minors `type(scope)!:`, other minors `feat(scope):` and
    // patches `fix(scope):`; release-please reads `!` (even on hidden ci:/chore: types) as an app
    // major bump, `feat` as minor and `fix` as patch. Only shipped npm/cargo deps may cut a release.
    {
      description: "Hidden chore: type without ! for non-shipped updates (tools, images)",
      matchPackageNames: ["*"],
      semanticCommitType: "chore",
      commitMessagePrefix: "{{semanticCommitType}}({{semanticCommitScope}}):",
    },
    {
      description: "Keep ci: for GitHub Actions updates",
      matchManagers: ["github-actions"],
      semanticCommitType: "ci",
    },
    {
      // `deps(<manager>):` (the Dependabot-era convention) bumps the app patch version and lands
      // under "Dependencies" in CHANGELOG.md.
      description: "Use deps(<manager>): commits for shipped npm and cargo dependencies",
      matchManagers: ["npm", "cargo"],
      semanticCommitType: "deps",
      commitMessagePrefix: "deps({{manager}}):",
    },
    {
      description: "Auto-merge patch bumps once they have aged 1 day",
      matchUpdateTypes: ["patch"],
      minimumReleaseAge: "1 day",
      automerge: true,
    },
    {
      // pnpm's default minimumReleaseAge fails `pnpm install` in CI on anything younger.
      description: "Hold every npm update until it has aged 1 day, matching pnpm",
      matchManagers: ["npm"],
      minimumReleaseAge: "1 day",
    },
    {
      // Renovate 44 defaults to timestamp-required: a release without a timestamp stays pending
      // forever. rust:1.99.1-slim had none, so the 1-day patch rule above never released it.
      description: "Do not hold Docker tags that come without a release timestamp",
      matchDatasources: ["docker"],
      minimumReleaseAgeBehaviour: "timestamp-optional",
    },
    {
      description: "Hold tower-sessions below 0.15 until axum-login publishes tower-sessions 0.15 support",
      matchPackageNames: ["tower-sessions", "tower-sessions-core"],
      allowedVersions: "<0.15",
    },
    {
      description: "adapter-static 4 requires SvelteKit 3, so the two major bumps must land together",
      matchPackageNames: ["@sveltejs/kit", "@sveltejs/adapter-static"],
      groupName: "sveltekit",
    },
    {
      // The Rust plugins and their JS bindings share an IPC contract: tauri-plugin-http 2.9.0 reads a
      // header the 2.8.x JS sends nothing for, so every webview fetch failed. One PR per family, and the
      // 1-day hold matches npm so cargo cannot land ahead of its JS side.
      description: "Group Tauri npm and cargo packages so each pair lands together",
      matchPackageNames: ["@tauri-apps/**", "tauri", "tauri-*"],
      groupName: "tauri",
      semanticCommitType: "deps",
      commitMessagePrefix: "deps(tauri):",
      minimumReleaseAge: "1 day",
    },
  ],
}
