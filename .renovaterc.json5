{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "abandonments:recommended",
    // Pin every github> preset to the same tag; an unpinned one tracks main.
    "github>home-operations/renovate-presets#8.1.0"
  ],
  // This repo is a fork; only a committed config makes Renovate process it.
  forkProcessing: "enabled",
  // Dependabot labelled every update PR.
  labels: ["dependencies"],
  // The operator webhook starts a run on any ticked dashboard checkbox; Renovate resets it on rewrite.
  dependencyDashboardFooter: "- [ ] <!-- manual job -->Check this box to trigger a request for Renovate to run again on this repository"
}
