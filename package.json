{
  "name": "mesh-organiser",
  "version": "4.0.2",
  "packageManager": "pnpm@12.9.1",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "tauri:build": "tauri build --no-sign --config src-tauri/tauri.release-csp.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src/ --cache --cache-location .eslintcache",
    "lint:fix": "eslint src/ --cache --cache-location .eslintcache --fix"
  },
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "~2.8.0",
    "@tauri-apps/plugin-fs": "~2.6.0",
    "@tauri-apps/plugin-http": "~2.8.0",
    "@tauri-apps/plugin-os": "~2.4.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "~2.13.0",
    "@threlte/core": "^8.6.0",
    "@threlte/extras": "^9.21.1",
    "@types/qs": "^6.15.1",
    "@types/three": "^0.186.0",
    "fflate": "^0.8.3",
    "qs": "^6.16.0",
    "three": "0.186.1",
