  "license": "MIT",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "tauri:build": "tauri build --no-sign --config src-tauri/tauri.release-csp.json",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint src/",
    "lint:fix": "oxlint src/ --fix"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "~2.8.0",
    "@tauri-apps/plugin-fs": "~2.7.0",
    "@tauri-apps/plugin-http": "~2.8.0",
    "@tauri-apps/plugin-os": "~2.4.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "~2.14.0",
    "@threlte/core": "^8.6.0",
    "@threlte/extras": "^9.21.1",
    "@types/qs": "^6.15.1",
    "@types/three": "^0.186.0",
    "fflate": "^0.8.3",
    "qs": "^6.16.0",
    "three": "0.186.1",
    "threejs-webworker-3mf-loader": "github:manyfold3d/threejs-webworker-3mf-loader"
