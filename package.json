    "@tauri-apps/plugin-os": "~2.4.0",
    "@tauri-apps/plugin-updater": "~2.14.1",
    "@threlte/core": "^8.7.0",
    "@threlte/extras": "^9.23.1",
    "@types/qs": "^6.15.1",
    "@types/three": "^0.187.0",
    "fflate": "^0.8.3",
    "qs": "^6.17.1",
    "three": "0.187.0",
