    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.5",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.6.2",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "bits-ui": "^2.19.2",
    "clsx": "^2.1.1",
    "jsdom": "^30.1.2",
    "mode-watcher": "^1.1.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.89.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "svelte-sonner": "^1.2.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^4.0.0",
