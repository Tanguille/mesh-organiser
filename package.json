    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.6.6",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "bits-ui": "^2.22.0",
    "clsx": "^2.1.1",
    "jsdom": "^31.0.1",
    "mode-watcher": "^1.1.0",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "svelte-sonner": "^1.2.3",
