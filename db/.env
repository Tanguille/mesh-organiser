# Database the sqlx query! macros check SQL against at compile time. The path is relative to the
# workspace root, where cargo runs rustc, so each checkout resolves its own copy. Do not bake an
# absolute path in via build.rs: the cargo target dir may be shared between checkouts, and cached
# build-script output would keep pointing at whichever checkout ran it last.
DATABASE_URL=sqlite:db/model.sqlite
